# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI providers
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
AI_FINGERPRINT_SALT=random-32-byte-hex-string

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sentry (optional — disabled when the DSN is unset)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Cache (optional — caching is disabled when unset). Redis over TLS, e.g. Upstash's rediss:// URL; server runtime only.
REDIS_URL=rediss://default:your-redis-password@your-redis-host:6379
